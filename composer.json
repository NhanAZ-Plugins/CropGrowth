{
    "name": "nhanaz/crop-growth",
    "description": "Bone meal growth effects for Axolotl-PM",
    "type": "pocketmine-plugin",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.50.0",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.49.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
